# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values to the repository.

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may use the admin page: comma-separated emails of Supabase Auth users
ADMIN_EMAILS=

# Paystack (Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=

# The public address of the site, with no trailing slash
SITE_URL=

# Optional: Resend, for emailed donation receipts
RESEND_API_KEY=
EMAIL_FROM=
